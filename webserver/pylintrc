[MASTER]

# Add files or directories matching the regex patterns to the ignore-list. The
# regex matches against paths and can be in Posix or Windows format.
# Excluding auto-generated code here.
# dar_api and whitelisted_images_api are dead (not registered) until the auth
# rework / #499 brings them back. Re-enable at the first release.
ignore-paths=^app/dar_api\.py$,
             ^app/whitelisted_images_api\.py$

# Specify a score threshold to be exceeded before program exits with error.
fail-under=9.0

[MESSAGES CONTROL]
# unused-import/argument/variable are off during the dagster rework (more noise
# than help). Re-enable at the first release.
disable=not-callable,
        raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        missing-timeout,
        unused-import,
        unused-argument,
        unused-variable

[FORMAT]
max-line-length=120
