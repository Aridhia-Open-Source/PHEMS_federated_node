# KICS config (ADR 0044). Run by the kics job in .github/workflows/security-extra.yml.
path:
  - k8s
  - build
  - dagster
  - nexus
  - experiments
  - pulumi
exclude-paths:
  - node_modules
  - charts
  - "nexus/ui/src/api"
type:
  - Kubernetes
  - Dockerfile
  - CICD
# Report only. Stage 2 (gate): fail-on: [high, critical] and drop --ignore-on-exit
fail-on:
  - high
  - critical
exclude-severities:
  - info
