# UC1 cardiac benchmarking (R, OMOP CDM 5.4): what `fncli experiment run` needs besides trigger.json (the image).
# Read by fncli experiment; these override .dev.env. The database is in values.yaml, its dataset in dataset.yaml, and the
# node project and its Gitea repos in bootstrap/examples/globals-uc1.yaml and projects/uc1.yaml.

# Seconds `run` waits for the task. The R study takes minutes.
RUN_TIMEOUT=1800

# Extra env for the task in `run` and `run --local` comes from DEV_ENV in the shell, as JSON. UC1_DEV=1 is the quick
# run: fewer cohorts, for proving the pipeline. Without it, or with FULL=1, `run` is the whole study:
#   DEV_ENV='{"UC1_DEV": "1"}' make experiments run uc1
