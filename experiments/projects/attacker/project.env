# A hostile task image: tries to break out of its isolation and prints BLOCKED or LEAKED per
# attempt (ADR 0022). Read by fncli experiment; these override .dev.env.

# The image: built from SOURCE_DIR (relative to experiments/) and pushed to the kind registry.
# In the project rather than sources/, which is not committed.
SOURCE_DIR=projects/attacker/image
IMAGE=localhost:5001/attacker-fn:latest

# The database, matching values.yaml. The schemas are the ones seed.sh creates.
DATASET_NAME=attacker-db
DATASET_USERNAME=attacker_user
DATASET_SECRET_NAME=db-datasets-attacker
DATASET_SCHEMA=cdm
DATASET_SCHEMA_WRITE=results

# The node project fncli sets up for it, with its own Gitea repos and token names.
TEST_PROJECT_NAME=attacker
DEFAULT_PROJECT_DATASET=attacker-db
TEST_TRIGGER_REPO=attacker-trigger-repo
TEST_TRIGGER_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/attacker-trigger-repo
TEST_RESULTS_REPO=attacker-results-repo
TEST_RESULTS_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/attacker-results-repo
GITEA_TOKEN_NAME=attacker-sensor
GITEA_RESULTS_TOKEN_NAME=attacker-results

# Seconds `run` waits for the task.
RUN_TIMEOUT=600

# Limits the task pod must get from the spec; the image checks its own cgroup against them.
RESOURCES='{"limits": {"cpu": "500m", "memory": "256Mi"}, "requests": {"cpu": "100m", "memory": "64Mi"}}'

# Optional DEV_ENV, extra env for the task as JSON: OTHER_RUN_ID is another run's folder name on the artifacts
# volume, which the task then tries to read; SECRET_NAME is another task's Secret to try to get;
# SLEEP_SECONDS makes it hang first, to see the pod's deadline end it. For example:
# DEV_ENV='{"SLEEP_SECONDS": "600"}'
