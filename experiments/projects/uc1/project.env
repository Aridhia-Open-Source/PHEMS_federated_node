# UC1 cardiac benchmarking (R, OMOP CDM 5.4). Read by fncli experiment; these override .dev.env.

# The image: built from SOURCE_DIR (relative to experiments/) and pushed to the kind registry.
SOURCE_DIR=sources/uc1
IMAGE=localhost:5001/uc1-fn:latest

# The database, matching values.yaml. The schemas are the ones seed/uc1_seed.py creates.
DATASET_NAME=uc1-omop
DATASET_USERNAME=uc1_omop_user
DATASET_SECRET_NAME=db-datasets-uc1
DATASET_SCHEMA=cdm
DATASET_SCHEMA_WRITE=results

# The node project fncli sets up for it, with its own Gitea repos. Gitea tells tokens apart
# by name, so they differ from the dev project's or minting one would revoke the other.
TEST_PROJECT_NAME=uc1
DEFAULT_PROJECT_DATASET=uc1-omop
TEST_TRIGGER_REPO=uc1-trigger-repo
TEST_TRIGGER_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/uc1-trigger-repo
TEST_RESULTS_REPO=uc1-results-repo
TEST_RESULTS_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/uc1-results-repo
GITEA_TOKEN_NAME=uc1-sensor
GITEA_RESULTS_TOKEN_NAME=uc1-results

# Seconds `run` waits for the task. The R study takes minutes.
RUN_TIMEOUT=1800

# Extra env for the task in `run` and `run-local`, as JSON. UC1_DEV=1 is the quick run: fewer
# cohorts, for proving the pipeline. FULL=1 leaves it out for the whole study.
DEV_ENV='{"UC1_DEV": "1"}'
