# The demo project: its database, and the task image in image/ (demo-fn). `fncli experiment seed demo` needs this file, and
# `down` tears down every project that has one, so the node project names are its own: unset,
# they fall back to .dev.env's, which would tear down the dev project. Read by fncli
# experiment; these override .dev.env.

# The database, matching values.yaml. The schemas are the ones seed.sh creates.
DATASET_NAME=demo-db
DATASET_USERNAME=demo_user
DATASET_SECRET_NAME=db-datasets-demo
DATASET_SCHEMA=cdm
DATASET_SCHEMA_WRITE=results

# Never set up in the node, so nothing is there to tear down.
TEST_PROJECT_NAME=demo
DEFAULT_PROJECT_DATASET=demo-db
TEST_TRIGGER_REPO=demo-trigger-repo
TEST_TRIGGER_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/demo-trigger-repo
TEST_RESULTS_REPO=demo-results-repo
TEST_RESULTS_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/demo-results-repo
GITEA_TOKEN_NAME=demo-sensor
GITEA_RESULTS_TOKEN_NAME=demo-results
