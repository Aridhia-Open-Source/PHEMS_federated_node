# A hostile task image: tries to break out of its isolation and prints BLOCKED or LEAKED per
# attempt (ADR 0022). What `fncli experiment run` needs besides trigger.json; read by fncli experiment, these override .dev.env.
# The database is in values.yaml, its dataset in dataset.yaml, the trigger in trigger.json (the image, and the CPU and
# memory limits the task pod must get from the spec: the image checks its own cgroup against them), and the node
# project and its Gitea repos in bootstrap/examples/globals-attacker.yaml and projects/attacker.yaml.

# Seconds `run` waits for the task.
RUN_TIMEOUT=600

# Optional DEV_ENV in the shell, extra env for the task as JSON: OTHER_RUN_ID is another run's folder name on the artifacts
# volume, which the task then tries to read; SECRET_NAME is another task's Secret to try to get;
# SLEEP_SECONDS makes it hang first, to see the pod's deadline end it. For example:
# DEV_ENV='{"SLEEP_SECONDS": "600"}' fncli experiment run attacker
