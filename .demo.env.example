# Config for `fncli demo`. Template in the repo root: cp .demo.env.example .demo.env
# The demo's own objects. Whatever is set here overrides the same name in .dev.env (and in the
# shell), so the demo has its own project, repos and dataset and never touches the project the
# e2e suites use (TEST_PROJECT_NAME in .dev.env).
# Everything not set here (GITEA_API_URI, BACKEND_URL, KEYCLOAK_NAMESPACE, TEST_PR_IMAGE ...)
# still comes from .dev.env.
# Names: lowercase letters, digits, '-' and '.' only, because they become Secret labels.
TEST_PROJECT_NAME=demo-gitea
TEST_TRIGGER_REPO=demo-trigger-repo
TEST_TRIGGER_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/demo-trigger-repo
TEST_TRIGGER_REPO_WATCH_DIR=specs/
TEST_RESULTS_REPO=demo-results-repo
TEST_RESULTS_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/demo-results-repo
TEST_RESULTS_TARGET_DIR=results/
# Dataset names are unique across the whole node.
DEFAULT_PROJECT_DATASET=demo-dataset
# Gitea tells tokens apart by name: these two must differ from each other and from the e2e
# project's (fn-sensor, fn-results), or replacing one token invalidates the other.
GITEA_TOKEN_NAME=demo-sensor
GITEA_RESULTS_TOKEN_NAME=demo-results
