# Local development environment for ./scripts/*, mise, the Tiltfile and fncli.
# Copy to .dev.env (gitignored by *.env) and fill in the first user's email and password.
#
#   mise run init-conf (does the two copies below and asks for the first user)
#   cp .dev.env.example .dev.env
#   cp k8s/federated-node/dev.example.values.yml k8s/federated-node/dev.values.yaml

# ---------------------------------------------------------------------------
# Cluster and release (scripts/cluster.sh, deploy.sh, teardown.sh, the Tiltfile)
# ---------------------------------------------------------------------------

# Tag applied to every locally built image (localhost:5001/<name>-fn:$DOCKER_TAG, see docker-bake.hcl).
# Must match the tag in your values file.
DOCKER_TAG=v1


# Release namespace. Must match the db host in your values file (db.<ns>.svc).
NAMESPACE=fn

# Helm release name.
RELEASE_NAME=fn-dev

# Values file, relative to k8s/federated-node/.
VALUES_FILE=dev.values.yaml

# Host directory backing the cluster's local PVs. cluster.sh bind-mounts it to /data
# inside the kind node, which is what the chart's storage.local.* values point at.
# Changing it needs the cluster recreated, since kind fixes its mounts at creation.
# FN_DATA_DIR=$HOME/.fn/data

# ---------------------------------------------------------------------------
# The first Keycloak user
# ---------------------------------------------------------------------------

# The first Keycloak user (firstUserSecret in the values file), an Administrator. This is your API login,
# so pick a password you will remember. deploy.sh stores both in the keycloak-first-user secret, and
# `fncli resource-set --revoked` (admin only) reads them from there to log in.
KEYCLOAK_FIRST_USER_EMAIL=
KEYCLOAK_FIRST_USER_PASSWORD=

# ---------------------------------------------------------------------------
# fncli: how this machine reaches the cluster
# ---------------------------------------------------------------------------
# The node itself (providers, repos, secrets, datasets, projects) is set up from bootstrap files in bootstrap/examples,
# not from this file: `fncli diff -f examples/globals-gitea.yaml`, then `fncli apply -f ...`. Which node, and the
# defaults of the commands, are in bootstrap/context.yaml (cp bootstrap/examples/context.yaml there).
# What is in this section and the next is read by the commands that still take their names from the env
# (verify-project, project-set, open-pr, ...). None of them may be empty.
# Gitea and nexus-api are reached through the Tilt port-forwards (4000 and 5000).

KEYCLOAK_NAMESPACE=keycloak
NEXUS_API_URL=http://localhost:5000
# The in-cluster Gitea address the sensor uses (the release namespace is in the host).
GITEA_API_URI=http://gitea.fn.svc:4000/api/v1
# Optional, these are the defaults:
# GITEA_URL=http://localhost:4000
# GITEA_ADMIN_USER=gitea_admin

# ---------------------------------------------------------------------------
# fncli: the dev project the env-reading commands work on
# ---------------------------------------------------------------------------
# Keep these equal to bootstrap/examples/globals-e2e.yaml and projects/e2e.yaml, which create them.

TEST_PROJECT_NAME=fn-dev

# The trigger Gitea repo, under the admin user, and how nexus-api knows it.
TEST_TRIGGER_REPO=fn-trigger-repo
TEST_TRIGGER_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/fn-trigger-repo
# Must not be empty: only PRs that change files under it are picked up.
TEST_TRIGGER_REPO_WATCH_DIR=specs/
# The branch the project watches (PRs merged into any other are skipped). Required: never guessed.
TEST_TRIGGER_REPO_BASE_BRANCH=main

# The results Gitea repo, how nexus-api knows it, and the directory in it that task results go under.
TEST_RESULTS_REPO=fn-results-repo
TEST_RESULTS_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/fn-results-repo
TEST_RESULTS_TARGET_DIR=results/
# The branch results pull requests start from and go into. Required: never guessed.
TEST_RESULTS_REPO_BASE_BRANCH=main

# The project's dataset. A stand-in: only its name matters, its database is a dummy.
# Dataset names are unique across the whole node.
DEFAULT_PROJECT_DATASET=dev-dataset

# ---------------------------------------------------------------------------
# GitHub next to Gitea (optional)
# ---------------------------------------------------------------------------
# A bootstrap file says which provider each repo is on, and the node keeps a provider record per host and a secret
# per repo, so the sensors and results delivery use each repo's own API client and token: Gitea OAuth for the Gitea
# repos, a GitHub App for a GitHub one. The GitHub bootstrap file (bootstrap/examples/globals-github.yaml) reads the
# App's two ids from here (the node.env_file of bootstrap/context.yaml is this file) and its private key from a .pem
# file named in the bootstrap file, so the key itself never goes in this file. The backend mints one-hour installation
# tokens from them.
#   GH_APP_ID=5612966
#   GH_INSTALLATION_ID=178588521
#
# fncli's pull requests into the trigger repo are the researcher's work, not the node's: on Gitea they use the admin
# login, on GitHub RESEARCHER_GIT_TOKEN (a personal access token that can write to the repo), or else the token of
# `gh auth login`. Everything else uses tokens the backend mints.
#   RESEARCHER_GIT_TOKEN=
#
# Register Aridhia-Open-Source/phems-sandbox (public, one repo for both roles) with the Tilt port-forwards up and
# the App's key at the path in the bootstrap file (SETUP_GIT_APPS.md):
#   fncli diff  -f examples/globals-github.yaml
#   fncli apply -f examples/globals-github.yaml
#   fncli apply -f examples/projects/demo-github.yaml
# The guided version of the same, up to a merged pull request:
#   fncli demo -f examples/projects/demo-github.yaml

# ---------------------------------------------------------------------------
# Database passwords
# ---------------------------------------------------------------------------
# They are deliberately absent: the chart generates all of them and reuses them on every upgrade.
# To read one back - e.g. nexus-api's:
#
#   kubectl get secret nexus-db -n "$NAMESPACE" \
#     -o jsonpath='{.data.password}' | base64 -d
#
# or all of them at once:  mise run show-db-passwords
#
# The one exception is an external/managed Postgres (create_db_deployment: false),
# whose admin password belongs to that server and so cannot be generated:
# POSTGRES_EXTERNAL=true
# POSTGRES_PASSWORD=
