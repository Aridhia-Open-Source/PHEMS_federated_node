# Copy to .dev.env (gitignored). Sourced by scripts/deploy.sh and scripts/reload_app.sh.

DOCKER_TAG=v1
CLUSTER_NAME=fn
# Namespace is baked into the values files (db.fn.svc)
NAMESPACE=fn
RELEASE_NAME=fn-dev
# Relative to k8s/federated-node/. Copy dev.example.values.yaml to dev.values.yaml first.
VALUES_FILE=dev.values.yaml

# PAT used by the dagster sensors and github_transfer
GH_TOKEN=

# GitHub App creds for the task-controller IdP; github-app secret is skipped if unset
GH_CLIENT_ID=
GH_SECRET=

KEYCLOAK_FIRST_USER_PASSWORD=
