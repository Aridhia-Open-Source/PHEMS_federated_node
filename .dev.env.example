# Local development environment for ./scripts/* and the Tiltfile.
# Copy to .dev.env (gitignored by *.env) and fill in the two secrets at the bottom.
#
#   cp .dev.env.example .dev.env
#   cp k8s/federated-node/dev.example.values.yml k8s/federated-node/dev.values.yaml

# Tag applied to every locally built image (localhost:5001/<dir>-fn:$DOCKER_TAG).
# Must match the tag in your values file.
DOCKER_TAG=v1

# kind cluster name; the kubectl context becomes kind-$CLUSTER_NAME.
CLUSTER_NAME=fn

# Release namespace. Must match the db host in your values file (db.<ns>.svc).
NAMESPACE=fn

# Helm release name.
RELEASE_NAME=fn-dev

# Values file, relative to k8s/federated-node/.
VALUES_FILE=dev.values.yaml

# Host directory backing the cluster's local PVs. cluster.sh bind-mounts it to /data
# inside the kind node, which is what the chart's storage.local.* values point at.
# Changing it needs the cluster recreated, since kind fixes its mounts at creation.
# FN_DATA_DIR=$HOME/.fn/data

# GitHub PAT for the dagster sensors and the results transfer: read on the
# repositories you register, write on fnDagster.gh.delivery_repo.
# deploy.sh puts it in the github-token secret as GH_TOKEN.
GH_TOKEN=

# Password for the first Keycloak user (firstUserSecret in the values file).
# This is your API login, so pick something you will remember.
KEYCLOAK_FIRST_USER_PASSWORD=

# fncli (scripts/fncli): sets up two Gitea repos (trigger and results), the backend
# project, a secret for each repo and the dataset, and the backend records for them.
# None of these may be empty.
# Gitea and the backend are reached through the Tilt port-forwards (4000 and 5000).
# The in-cluster Gitea address the sensor uses (the release namespace is in the host).
GITEA_API_URI=http://gitea.fn.svc:4000/api/v1
KEYCLOAK_NAMESPACE=keycloak
BACKEND_URL=http://localhost:5000
# The trigger Gitea repo to create under the admin user, and how the backend knows it.
# The git token secret is named <TEST_TRIGGER_REPO>-creds, so keep the name lowercase
# with '-' or '.' only. TEST_PROJECT_NAME must also be lowercase alphanumerics with '-' or '.'
# because the dataset secret label is <project>-dataset-creds.
TEST_TRIGGER_REPO=fn-trigger-repo
TEST_TRIGGER_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/fn-trigger-repo
# Must not be empty: only PRs that change files under it are picked up.
TEST_TRIGGER_REPO_WATCH_DIR=specs/
TEST_PROJECT_NAME=fn-dev
# The results Gitea repo (same naming rule: its secret is <TEST_RESULTS_REPO>-creds), how
# the backend knows it, and the directory in it that task results go under.
TEST_RESULTS_REPO=fn-results-repo
TEST_RESULTS_REPO_URI=http://gitea.fn.svc:4000/gitea_admin/fn-results-repo
TEST_RESULTS_TARGET_DIR=results/
# The project's dataset. A stand-in: only its name matters, its database is a dummy.
# Dataset names are unique across the whole node.
DEFAULT_PROJECT_DATASET=dev-dataset
# The image the spec file of a PR opened by `fncli open-pr` runs.
TEST_PR_IMAGE=localhost:5001/pypipes-fn:latest
# Optional, these are the defaults:
# GITEA_URL=http://localhost:4000
# GITEA_ADMIN_USER=gitea_admin
# GITEA_TOKEN_NAME=fn-sensor
# Gitea tells tokens apart by name, so these two must differ: replacing one token would
# invalidate the other.
# GITEA_RESULTS_TOKEN_NAME=fn-results

# Database passwords are deliberately absent: the chart generates all of them and
# reuses them on every upgrade. To read one back - e.g. the UC1 dataset password
# that `make uc1-seed` needs:
#
#   kubectl get secret db-datasets-uc1 -n "$NAMESPACE" \
#     -o jsonpath='{.data.password}' | base64 -d
#
# or all of them at once:  make show-db-passwords
#
# The one exception is an external/managed Postgres (create_db_deployment: false),
# whose admin password belongs to that server and so cannot be generated:
# POSTGRES_EXTERNAL=true
# POSTGRES_PASSWORD=
