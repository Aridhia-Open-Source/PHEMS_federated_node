# Environment for the UC3 seed scripts (uc3_make_seed.sh -> uc3_drop.sh,
# uc3_seed.py, backend_seed.py) and ../scripts/run_uc3_local.sh.
#
#   cp dev.db/uc3.env.example dev.db/uc3.env
#
# Same contract as dev.db/.env does for UC1, in its own file so both use cases can
# be seeded and registered side by side. Requires `./scripts/portfwd.sh`: the
# shell/psql steps talk to the dataset DB over a port-forward (LOCAL_*), while the
# dataset row registered in the backend must use the in-cluster address
# (CLUSTER_DATASET_HOST), since it is the task pods that dial it.

# Which dotenv file backend_seed.py / uc3_read.py read. Must name this file, or
# they fall back to dev.db/.env and register the UC1 dataset instead.
SEED_ENV_FILE=uc3.env

# Backend API, via `kubectl port-forward -n fn svc/backend 5000:5000`
BACKEND_API_URI=http://localhost:5000

# --- Dataset DB: how THIS machine reaches it (psql) ------------------------
# via `kubectl port-forward -n fn svc/db-datasets 5433:5432`
LOCAL_DATASET_HOST=localhost
LOCAL_DATASET_PORT=5433

# --- Dataset DB: how the CLUSTER reaches it (stored on the dataset row) ----
CLUSTER_DATASET_HOST=db-datasets.fn.svc
DATASET_PORT=5432

# Must match datasetDb.dbs.uc3 in k8s/federated-node/dev.values.yaml. The password
# is generated by the chart, so leave it unset: dataset_password.sh reads it from
# the secret named below. Set it only to override.
DATASET_NAME=uc3_omop
DATASET_USERNAME=uc3_omop_user
DATASET_PASSWORD=
DATASET_SECRET_NAME=db-datasets-uc3
DATASET_TYPE=postgres

# Read schema for the OMOP CDM tables; schema_write is where task pods write their
# output (exported to task pods as WRITE_SCHEMA - UC3's R stage computes
# uc3_cohort/uc3_measurements/uc3_treatment there, and its julia stage reads them
# back). These MUST match CDM_SCHEMA / WRITE_SCHEMA in uc3_seed.py, which hardcodes
# them -- the seed creates the schemas, this only records where they are.
DATASET_SCHEMA=cdm
DATASET_SCHEMA_WRITE=results

# --- Repository watched for incoming specs --------------------------------
# The dagster sensor resolves a task's dataset from the repository row the spec
# arrived through, and Repository.uri is unique in the backend - so only one use
# case can own this repo at a time, and whichever was seeded last (uc1-seed or
# uc3-seed) is the one specs get delivered to. Its own watch dir keeps UC1's
# incoming specs from being picked up as UC3 runs while UC3 owns the row.
REPO_URI=github.com/Aridhia-Open-Source/phems-sandbox
REPO_WATCH_DIR=mgmt/requests-uc3
REPO_BRANCH=main
REPO_INITIAL_CURSOR=2019-05-01T00:00:00

# --- Data Access Request --------------------------------------------------
# Read at import time by backend_seed.py but not currently used by seed().
REQUEST_USER_ID=system@phems.local
REQUEST_PROJECT_NAME=UC3-Dose-Interference
REQUEST_TITLE="UC3 Dose Interference Model"
REQUEST_DESCRIPTION="Synthetic haemophilia OMOP data for UC3 testing"
REQUEST_START_DATE=2019-05-01T00:00:00
REQUEST_END_DATE=2030-12-31T00:00:00
