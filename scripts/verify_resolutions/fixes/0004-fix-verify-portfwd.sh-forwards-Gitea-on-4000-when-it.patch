From c81198fbffcdbbae4bbabe0c9f8ccf445616091e Mon Sep 17 00:00:00 2001
From: codepint <george.eddie@aridhia.com>
Date: Tue, 24 Nov 2026 02:38:21 +0000
Subject: [PATCH 4/5] fix(verify): portfwd.sh forwards Gitea on 4000 when it is
 deployed [skip ci]

---
 scripts/portfwd.sh | 1 +
 1 file changed, 1 insertion(+)

diff --git a/scripts/portfwd.sh b/scripts/portfwd.sh
index cb445e3a2..6e62097c2 100755
--- a/scripts/portfwd.sh
+++ b/scripts/portfwd.sh
@@ -19,4 +19,5 @@ kubectl port-forward -n fn svc/fn-dev-dagster-webserver 3000:80 & \
 kubectl port-forward -n fn svc/nexus-api 5000:5000 & \
 kubectl port-forward -n fn svc/nexus-ui 8088:80 & \
 kubectl port-forward -n fn svc/db 5432:5432 & \
+{ kubectl get -n fn svc/gitea > /dev/null 2>&1 && kubectl port-forward -n fn svc/gitea 4000:4000; } & \
 kubectl port-forward -n keycloak svc/keycloak 8080:80
