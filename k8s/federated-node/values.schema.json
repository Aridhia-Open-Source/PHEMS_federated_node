{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "required": [
        "db"
    ],
    "definitions": {
        "tag": {
            "type": [
                "string",
                "null"
            ]
        },
        "taskReview": {
            "type": "boolean",
            "default": false
        },
        "capacity": {
            "type": "string",
            "description": "How much to reserve for tasks, defaults to 10Gi. Other possible units are Mi, Ti, Ki",
            "pattern": "^\\d+(M|G|K)i{0,1}$"
        },
        "host": {
            "type": "string",
            "description": "Hostname where the FN can be reached at. Optional, also used to name the results files"
        },
        "iplist": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    },
                    "ips": {
                        "$ref": "#/definitions/ip_address"
                    }
                }
            }
        },
        "namespaces": {
            "type": "object",
            "properties": {
                "keycloak": {
                    "type": "string",
                    "default": "keycloak"
                },
                "tasks": {
                    "type": "string",
                    "default": "tasks"
                },
                "controller": {
                    "type": "string",
                    "default": "fn-controller"
                }
            }
        },
        "ip_address": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[0-9]{1,3}/.[0-9]{1,3}/.[0-9]{1,3}/.[0-9]{1,3}(//[0-9]{1,3}){0,1}$"
            }
        }
    },
    "properties": {
        "backend": {
            "type": "object",
            "properties": {
                "replicas": {
                    "type": "integer",
                    "default": 1
                },
                "tag": {
                    "$ref": "#/definitions/tag"
                }
            }
        },
        "keycloak": {
            "type": "object",
            "properties": {
                "replicas": {
                    "type": "integer",
                    "default": 2
                },
                "tag": {
                    "$ref": "#/definitions/tag"
                }
            }
        },
        "autoscaling": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "global": {
            "type": "object",
            "description": "Shared values across all charts",
            "properties": {
                "namespaces": {
                    "$ref": "#/definitions/namespaces",
                    "description": "Namespaces this chart and the task-controller subchart both use. Set them here, not at the top level - only global reaches the subchart"
                },
                "host": {
                    "$ref": "#/definitions/host"
                },
                "taskReview": {
                    "$ref": "#/definitions/taskReview"
                },
                "postgresqlSecretName": {
                    "type": "string",
                    "description": "Name of the secret holding Dagster's database password. Read by the dagster subchart and by this chart's db-init job; the key is always postgresql-password",
                    "default": "dagster-postgresql-secret"
                }
            }
        },
        "token": {
            "type": "object",
            "properties": {
                "life": {
                    "type": "integer",
                    "default": 2592000,
                    "description": "Duration in seconds for tokens"
                }
            }
        },
        "local_development": {
            "type": "boolean",
            "description": "Toggle for local development. Mostly to ignore SSL",
            "default": false
        },
        "create_db_deployment": {
            "type": "boolean",
            "description": "Only for development purposes. Instable for production usage",
            "default": false
        },
        "db": {
            "type": "object",
            "required": [
                "host"
            ],
            "properties": {
                "enforceSSL": {
                    "type": "boolean",
                    "default": false
                },
                "port": {
                    "type": "integer",
                    "default": 5432
                },
                "host": {
                    "type": "string"
                },
                "superuser": {
                    "type": "string",
                    "default": "postgres",
                    "description": "Superuser/admin login the *-db-init jobs connect as. Azure Database for PostgreSQL Flexible Server has no 'postgres' role, use the server's admin user"
                },
                "secret": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "description": "Secret for DB superuser credentials"
                        },
                        "key": {
                            "type": "string",
                            "description": "Secret key where the superuser password is stored"
                        }
                    },
                    "description": "Where the Postgres superuser password lives. Generated by the chart when create_db_deployment is true; supplied by you when Postgres is external and db.manageRolesAndDatabases is true; not needed at all when that is false"
                },
                "passwords": {
                    "type": "object",
                    "description": "Fixed passwords instead of generated ones, for tests and throwaway clusters via --set. Do not put real passwords in a values file - they end up in git, in `helm get values` and in the release Secret. Use createPasswordSecrets: false and a secret manager instead",
                    "properties": {
                        "superuser": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "backend": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "keycloak": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "dagster": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "datasets": {
                            "type": "object",
                            "description": "Keyed by datasetDb.dbs key, plus 'superuser'"
                        }
                    }
                },
                "manageRolesAndDatabases": {
                    "type": "boolean",
                    "default": true,
                    "description": "Create and maintain each component's database, role and grants with the *-db-init hooks. False means they already exist: the chart then needs no superuser, generates no passwords, requires one secret per role, and renders a db-check hook that verifies those credentials before anything is installed"
                },
                "createPasswordSecrets": {
                    "type": "boolean",
                    "default": true,
                    "description": "Create the per-role password Secrets. False when something else owns them (External Secrets, SealedSecrets, Vault): the chart expects them to exist and never needs their value at render time, which is what makes it safe under ArgoCD"
                }
            }
        },
        "cleanupTime": {
            "type": "integer",
            "description": "Amount of days the result stored in the storage will be kept for"
        },
        "taskReview": {
            "$ref": "#/definitions/taskReview"
        },
        "firstUserSecret": {
            "type": "object",
            "required": [
                "name",
                "email",
                "passKey"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The secret name that will hold the password to use for the user"
                },
                "passKey": {
                    "type": "string",
                    "description": "The key holding the password"
                },
                "firstName": {
                    "type": "string",
                    "description": "User's last name"
                },
                "lastName": {
                    "type": "string",
                    "description": "User's last name"
                },
                "email": {
                    "type": "string",
                    "description": "User's email address, this will also be the username"
                }
            }
        },
        "federatedNode": {
            "type": "object",
            "properties": {
                "enable_image_whitelist": {
                    "type": "boolean",
                    "default": false
                },
                "port": {
                    "type": "integer",
                    "default": 5000
                },
                "volumes": {
                    "type": "object",
                    "properties": {
                        "results_path": {
                            "type": "string"
                        },
                        "task_pod_results_path": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "storage": {
            "type": "object",
            "properties": {
                "capacity": {
                    "$ref": "#/definitions/capacity"
                },
                "mountOptions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                },
                "azure": {
                    "type": "object",
                    "required": [
                        "secretName",
                        "shareName"
                    ],
                    "description": "If running a cluster on azure, or using an Azure Storage Class, this will be the suggested config",
                    "properties": {
                        "secretName": {
                            "type": "string",
                            "description": "Secret name where the credentials for the azure storage are saved"
                        },
                        "shareName": {
                            "type": "string",
                            "description": "Share name within the azure storage account"
                        },
                        "provisioner": {
                            "type": "string",
                            "description": "Optional provisioner for the azure storage. Defaults to file.csi.azure.com for the Dagster artifacts volume, which needs ReadWriteMany"
                        },
                        "skuName": {
                            "type": "string",
                            "default": "Premium_LRS",
                            "description": "Azure Files SKU for the generated StorageClass"
                        },
                        "resourceGroup": {
                            "type": "string",
                            "description": "Resource group holding the storage account, when it differs from the AKS node resource group"
                        }
                    }
                },
                "aws": {
                    "type": "object",
                    "required": [
                        "fileSystemId",
                        "accessPointId"
                    ],
                    "description": "If running a cluster on AWS this will be the suggested config",
                    "properties": {
                        "fileSystemId": {
                            "type": "string",
                            "description": "EFS system id, e.g. fs-xxxxxxxxx"
                        },
                        "accessPointId": {
                            "type": "string",
                            "description": "Optional, access point id for better permission and isolation management in the EFS"
                        }
                    }
                },
                "nfs": {
                    "type": "object",
                    "description": "If running a cluster off the cloud, this will be the suggested config",
                    "properties": {
                        "provisioner": {
                            "type": "string"
                        },
                        "path": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string"
                        }
                    }
                },
                "local": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "Where to persist files in the host machine"
                        },
                        "dbpath": {
                            "type": "string"
                        },
                        "datasetDbpath": {
                            "type": "string",
                            "description": "Host path for the dataset Postgres data directory (datasetDb.create)"
                        }
                    }
                }
            },
            "oneOf": [
                {
                    "required": [
                        "azure"
                    ]
                },
                {
                    "required": [
                        "aws"
                    ]
                },
                {
                    "required": [
                        "local"
                    ]
                },
                {
                    "required": [
                        "nfs"
                    ]
                }
            ]
        },
        "pullPolicy": {
            "type": "string",
            "enum": [
                "Always",
                "IfNotPresent"
            ]
        },
        "host": {
            "$ref": "#/definitions/host"
        },
        "tls": {
            "type": "object",
            "properties": {
                "secretName": {
                    "type": "string",
                    "description": "Secret name where the SSL certificate is. Defaults to tls if the tls section is set"
                }
            }
        },
        "on_aks": {
            "type": "boolean",
            "description": "Deploying on Azure?",
            "default": false
        },
        "on_eks": {
            "type": "boolean",
            "description": "Deploying on AWS?",
            "default": false
        },
        "integrations": {
            "type": "object",
            "properties": {
                "domains": {
                    "type": "array",
                    "description": "The list of third party host that can reach the Federated Node. Otherwise these will be blocked by CSP policies. This will not affect direct user API usage.",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "certs": {
            "type": "object",
            "properties": {
                "rotationPolicy": {
                    "type": "string",
                    "enum": [
                        "Never"
                    ]
                },
                "azure": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "required": [
                        "secretName",
                        "configmap"
                    ],
                    "properties": {
                        "secretName": {
                            "type": "string"
                        },
                        "configmap": {
                            "type": "string"
                        }
                    }
                },
                "aws": {
                    "type": "string",
                    "description": "Secret that holds all of the AWS related info for SSL certificate management"
                }
            }
        },
        "smoketests": {
            "type": "boolean",
            "description": "Enables simple smoketests on the helm charts",
            "default": false
        },
        "outboundMode": {
            "type": "boolean",
            "description": "Enables outbound connection mode",
            "default": false
        },
        "cert-manager": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false
                },
                "namespace": {
                    "type": "string",
                    "default": "fn-certmanager"
                },
                "installCRDs": {
                    "type": "boolean",
                    "default": true
                }
            }
        },
        "traefik": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false
                },
                "gateway": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": true
                        },
                        "name": {
                            "type": "string",
                            "default": "traefik-fn-gateway"
                        }
                    }
                },
                "gatewayClass": {
                    "type": "object",
                    "properties": {
                        "ingressClassResource": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "default": "traefik-fn-gateway-class"
                                }
                            }
                        }
                    }
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "spec": {
                            "type": "object",
                            "properties": {
                                "externalIPs": {
                                    "$ref": "#/definitions/iplist"
                                },
                                "externalTrafficPolicy": {
                                    "type": "string",
                                    "description": "For AKS deployment only",
                                    "default": "Local",
                                    "enum": [
                                        "Local",
                                        "Cluster"
                                    ]
                                }
                            }
                        }
                    }
                },
                "providers": {
                    "type": "object",
                    "properties": {
                        "kubernetesCRD": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean",
                                    "default": true
                                }
                            }
                        },
                        "kubernetesGateway": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean",
                                    "default": true
                                }
                            }
                        },
                        "kubernetesIngress": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean",
                                    "default": false
                                }
                            }
                        }
                    }
                },
                "api": {
                    "type": "object",
                    "properties": {
                        "dashboard": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                }
            }
        },
        "fnDagster": {
            "type": "object",
            "description": "Federated Node specific Dagster configuration, as opposed to the upstream dagster subchart values",
            "properties": {
                "artifactMountPath": {
                    "type": "string",
                    "default": "/mnt/dagster/artifacts"
                },
                "artifactsPvcName": {
                    "type": "string",
                    "default": "artifacts-pvc"
                },
                "artifacts": {
                    "type": "object",
                    "description": "Permissions on the artifacts volume that analytical (pipes) pods write results to",
                    "properties": {
                        "fileMode": {
                            "type": "string",
                            "default": "0777",
                            "pattern": "^0[0-7]{3}$",
                            "description": "Azure Files only. Must be a quoted octal string, e.g. \"0777\""
                        },
                        "dirMode": {
                            "type": "string",
                            "default": "0777",
                            "pattern": "^0[0-7]{3}$",
                            "description": "Azure Files only. Must be a quoted octal string, e.g. \"0777\""
                        },
                        "mountOptions": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "default": [],
                            "description": "If set, replaces ALL computed mount options for the artifacts volume"
                        },
                        "securityContext": {
                            "type": "object",
                            "description": "Pod securityContext for pipes task pods. fsGroup only takes effect on storage.local",
                            "properties": {
                                "fsGroup": {
                                    "type": "integer"
                                },
                                "runAsUser": {
                                    "type": "integer"
                                },
                                "runAsGroup": {
                                    "type": "integer"
                                },
                                "supplementalGroups": {
                                    "type": "array",
                                    "items": {
                                        "type": "integer"
                                    }
                                }
                            }
                        }
                    }
                },
                "createDB": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run the dagster-db-init job to create the dagster database and role. Needs a reachable superuser login, see db.superuser"
                },
                "gh": {
                    "type": "object",
                    "properties": {
                        "delivery_repo": {
                            "type": "string",
                            "description": "Repository results are delivered to"
                        },
                        "resultsDir": {
                            "type": "string",
                            "description": "Path within the delivery repo where results are written"
                        }
                    }
                },
                "image": {
                    "type": "string",
                    "default": "ghcr.io/aridhia-open-source/dagster_fn",
                    "description": "Dagster code image. Its tag follows default_image_tag/appVersion - see fnDagster.tag"
                },
                "tag": {
                    "$ref": "#/definitions/tag"
                },
                "codeServer": {
                    "type": "object",
                    "description": "The Dagster code location (gRPC) server, owned by this chart rather than the dagster-user-deployments subchart so its image tag can follow appVersion",
                    "properties": {
                        "name": {
                            "type": "string",
                            "default": "dagster-fn",
                            "description": "Service name, and the gRPC host in the workspace file"
                        },
                        "port": {
                            "type": "integer",
                            "default": 3030
                        },
                        "replicas": {
                            "type": "integer",
                            "default": 1
                        },
                        "module": {
                            "type": "string",
                            "default": "app.definitions",
                            "description": "Python module passed to `dagster api grpc -m`"
                        },
                        "resources": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "dagster": {
            "type": "object",
            "description": "Values passed through to the upstream dagster subchart. Only the keys the Federated Node depends on are validated here",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "default_image_tag": {
            "$ref": "#/definitions/tag",
            "description": "Tag for every image this chart publishes. Unset means the chart's appVersion"
        },
        "datasetDb": {
            "type": "object",
            "description": "A second, in-cluster PostgreSQL holding dataset data. A development fixture: real datasets are registered through the /datasets API, which stores their credentials separately. `create` covers both deploying the server and creating the roles in `dbs`, so `dbs` without `create` is rejected",
            "properties": {
                "create": {
                    "type": "boolean",
                    "default": false
                },
                "host": {
                    "type": "string",
                    "default": "db-datasets",
                    "description": "Defaults to the in-cluster Service created alongside it"
                },
                "port": {
                    "type": "integer",
                    "default": 5432
                },
                "superuser": {
                    "type": "string",
                    "default": "postgres"
                },
                "secret": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "key": {
                            "type": "string"
                        }
                    }
                },
                "dbs": {
                    "type": "object",
                    "description": "Keyed by a short name; each entry gets a database, a role and a generated password",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Database name"
                            },
                            "user": {
                                "type": "string",
                                "description": "Role name"
                            },
                            "secret": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "key": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
