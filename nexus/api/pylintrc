[MASTER]

# Specify a score threshold to be exceeded before program exits with error.
fail-under=9.0

[MESSAGES CONTROL]
# unused-import/argument/variable are off during the dagster rework (more noise
# than help). Re-enable at the first release.
disable=not-callable,
        raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        missing-timeout,
        unused-import,
        unused-argument,
        unused-variable

[FORMAT]
max-line-length=120
