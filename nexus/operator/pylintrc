[MASTER]

# Add files or directories matching the regex patterns to the ignore-list. The
# regex matches against paths and can be in Posix or Windows format.
# nexus-api and Dagster do not lint their tests either
ignore-paths=^tests/

# Specify a score threshold to be exceeded before program exits with error.
fail-under=9.0

[MESSAGES CONTROL]
# Same as dagster/pylintrc
disable=not-callable,
        raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        missing-timeout,
        unused-import,
        unused-argument,
        unused-variable,
        missing-module-docstring,
        missing-class-docstring,
        missing-function-docstring

[FORMAT]
max-line-length=120
