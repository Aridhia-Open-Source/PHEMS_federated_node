{
  "name": "nexus-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "openapi-fetch": "^0.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
