[MASTER]

# Add files or directories matching the regex patterns to the ignore-list. The
# regex matches against paths and can be in Posix or Windows format.
# Tests live under app/ here; the webserver doesn't lint its tests either.
ignore-paths=^app/tests/

# Specify a score threshold to be exceeded before program exits with error.
fail-under=9.0

[MESSAGES CONTROL]
# unused-import/argument/variable and the docstring checks are off during the dagster
# rework (more noise than help). Re-enable at the first release. Same as webserver/pylintrc.
disable=not-callable,
        raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        missing-timeout,
        unused-import,
        unused-argument,
        unused-variable,
        missing-module-docstring,
        missing-class-docstring,
        missing-function-docstring

[FORMAT]
max-line-length=120
