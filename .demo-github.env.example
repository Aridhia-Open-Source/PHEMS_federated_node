# Config for `fncli --env-file .demo-github.env demo`: the demo on an existing GitHub repo. Any other
# command takes it the same way, or from FNCLI_ENV_FILE=.demo-github.env.
# Template in the repo root: cp .demo-github.env.example .demo-github.env
# Overrides .dev.env like .demo.env does. A github.com repo uri is what makes fncli use GitHub. The node
# mints its tokens from the GitHub App in GH_APP_ID, GH_INSTALLATION_ID and GH_PRIVATE_KEY (see
# SETUP_GIT_APPS.md); the demo's own pull requests into the trigger repo use RESEARCHER_GIT_TOKEN, or
# else the token of `gh auth login`. fncli never creates or deletes GitHub repos or tokens.
TEST_PROJECT_NAME=demo-github
# One repo is both the trigger repo and the results repo: the sensor only picks up PRs that
# change files under the watch dir, so the results PRs are not seen as triggers.
TEST_TRIGGER_REPO=phems-sandbox
TEST_TRIGGER_REPO_URI=https://github.com/Aridhia-Open-Source/phems-sandbox
TEST_TRIGGER_REPO_WATCH_DIR=mgmt/requests/
TEST_TRIGGER_REPO_BASE_BRANCH=main
TEST_RESULTS_REPO=phems-sandbox
TEST_RESULTS_REPO_URI=https://github.com/Aridhia-Open-Source/phems-sandbox
TEST_RESULTS_TARGET_DIR=mgmt/results/
TEST_RESULTS_REPO_BASE_BRANCH=main
DEFAULT_PROJECT_DATASET=demo-github-dataset
